generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum ProductType {
  BOOK
  PHYSICAL
}

enum BookFormat {
  PHYSICAL
  PDF
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model AdminUser {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String
  role           AdminRole @default(ADMIN)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  manualInvoices Invoice[]

  @@index([email])
}

model Customer {
  id                String                   @id @default(uuid())
  name              String
  email             String                   @unique
  phone             String?
  passwordHash      String
  isActive          Boolean                  @default(true)
  emailVerifiedAt   DateTime?
  // null = the customer has never chosen a password (account auto-created from a guest order and
  // reached only through one-time email codes). Set the first time they set or reset a password.
  passwordSetAt     DateTime?
  autoCreated       Boolean                  @default(false)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  addresses         Address[]
  loginOtps         CustomerLoginOtp[]
  orders            Order[]
  refreshSessions   CustomerRefreshSession[]
  passwordResets    PasswordResetToken[]
  cart              Cart?
  couponRedemptions CouponRedemption[]
  reviews           ProductReview[]
  wishlistItems     WishlistItem[]
  notifications     CustomerNotification[]
  returnRequests    ReturnRequest[]

  @@index([email])
}

model Address {
  id                String   @id @default(uuid())
  customerId        String
  label             String
  fullName          String
  phone             String
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  postalCode        String
  country           String   @default("India")
  isDefault         Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  isDefaultShipping Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerRefreshSession {
  id         String    @id @default(uuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  userAgent  String?
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model Cart {
  id                  String     @id @default(uuid())
  customerId          String     @unique
  updatedAt           DateTime   @updatedAt
  // Abandoned-cart recovery bookkeeping — set once a recovery email has been
  // sent so the trigger can never fire twice for the same idle cart, and
  // cleared (recoveredAt set) once the customer converts.
  recoveryEmailSentAt DateTime?
  recoveredAt         DateTime?
  customer            Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items               CartItem[]
}

model CartItem {
  id         String          @id @default(uuid())
  cartId     String
  productId  String
  variantId  String?
  bookFormat BookFormat?
  quantity   Int
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId, bookFormat])
  @@index([productId])
}

model Category {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  description      String?
  parentId         String?
  image            String?
  icon             String?
  logo             String?
  desktopBanner    String?
  mobileBanner     String?
  // Multi-banner carousel (additive). Legacy desktopBanner/mobileBanner act as banner #1 when `banners` is null/empty.
  banners          Json?
  bannerAutoplay   Boolean  @default(true)
  bannerIntervalMs Int      @default(5000)
  isFeatured       Boolean  @default(false)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToSubcategory")
  products Product[]

  @@index([parentId])
  @@index([isActive])
  @@index([isFeatured])
}

model NavigationMenu {
  id        String           @id @default(uuid())
  code      String           @unique
  title     String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  items     NavigationItem[]

  @@index([code])
}

enum NavigationItemType {
  CATEGORY
  COLLECTION
  PAGE
  CUSTOM
}

model NavigationItem {
  id        String             @id @default(uuid())
  menuId    String
  parentId  String?
  title     String
  url       String?
  type      NavigationItemType @default(CUSTOM)
  targetId  String?
  sortOrder Int                @default(0)
  isActive  Boolean            @default(true)
  icon      String?
  badgeText String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  menu     NavigationMenu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   NavigationItem?  @relation("NavItemToSubItem", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavItemToSubItem")

  @@index([menuId])
  @@index([parentId])
  @@index([sortOrder])
}

enum CollectionType {
  MANUAL
  CATEGORY
  TAG
  FEATURED
  BEST_SELLER
  NEW_ARRIVAL
  TRENDING
  PRICE_RANGE
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponTargetType {
  ALL
  PRODUCT
  CATEGORY
  COLLECTION
}

enum TaxPricingMode {
  TAX_INCLUSIVE
  TAX_EXCLUSIVE
}

model Product {
  id                  String         @id @default(uuid())
  name                String
  slug                String         @unique
  brand               String?
  shortDescription    String?
  description         String?
  productType         ProductType
  categoryId          String
  sku                 String?        @unique
  price               Decimal        @db.Decimal(10, 2)
  salePrice           Decimal?       @db.Decimal(10, 2)
  mrp                 Decimal?       @db.Decimal(10, 2)
  costPrice           Decimal?       @db.Decimal(10, 2)
  stockQuantity       Int            @default(0)
  lowStockThreshold   Int            @default(5)
  lowStockNotifiedAt  DateTime? // dedupe: set when a LOW_STOCK/OUT_OF_STOCK notification fires, cleared once stock recovers above threshold
  trackInventory      Boolean        @default(true)
  isFeatured          Boolean        @default(false)
  isBestSeller        Boolean        @default(false)
  isNewArrival        Boolean        @default(false)
  isTrending          Boolean        @default(false)
  isActive            Boolean        @default(true)
  sortOrder           Int            @default(0)
  tags                String[]       @default([])
  materials           String?
  dimensions          String?
  // Operational package data for couriers (NOT the customer-facing `dimensions` text).
  // Canonical units: grams and millimetres. Null = not set (variant inherits from product).
  shipWeightGrams     Int?
  shipLengthMm        Int?
  shipWidthMm         Int?
  shipHeightMm        Int?
  careInstructions    String?
  whatsIncluded       String?
  shippingInformation String?
  specifications      Json?
  seoTitle            String?
  seoDescription      String?
  ogImage             String?
  attributes          Json?
  isDigital           Boolean        @default(false)
  // GST / invoicing fields (Phase 1 foundation). Nullable where existing
  // products have no data yet — never backfilled with a guessed value.
  hsnCode             String?
  gstRate             Decimal?       @db.Decimal(4, 2)
  unit                String         @default("PCS")
  taxPricingMode      TaxPricingMode @default(TAX_EXCLUSIVE)
  invoiceName         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  bookDetail    ProductBookDetails?
  orderItems    OrderItem[]
  cartItems     CartItem[]
  collections   CollectionProduct[]
  variants      ProductVariant[]
  reviews       ProductReview[]
  wishlistItems WishlistItem[]
  bookFormats   BookFormatOption[]

  @@index([categoryId])
  @@index([productType])
  @@index([isActive])
  @@index([isFeatured])
  @@index([isBestSeller])
  @@index([isNewArrival])
  @@index([isTrending])
  @@index([sortOrder])
}

model ProductVariant {
  id                 String    @id @default(uuid())
  productId          String
  name               String
  sku                String    @unique
  priceOverride      Decimal?  @db.Decimal(10, 2)
  stockQuantity      Int       @default(0)
  lowStockThreshold  Int? // nullable per-variant override; falls back to product/global threshold
  lowStockNotifiedAt DateTime? // dedupe: set when a LOW_STOCK/OUT_OF_STOCK notification fires, cleared once stock recovers above threshold
  isActive           Boolean   @default(true)
  attributes         Json?
  // Optional overrides — null means inherit from the parent Product.
  // taxPricingMode is intentionally NOT overridden here; it always follows
  // the parent Product.
  hsnCode            String?
  gstRate            Decimal?  @db.Decimal(4, 2)
  unit               String?
  // Operational package data for couriers (NOT the customer-facing `dimensions` text).
  // Canonical units: grams and millimetres. Null = not set (variant inherits from product).
  shipWeightGrams    Int?
  shipLengthMm       Int?
  shipWidthMm        Int?
  shipHeightMm       Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  @@index([productId])
  @@index([productId, isActive])
}

model Collection {
  id             String              @id @default(uuid())
  title          String
  slug           String              @unique
  description    String?
  heroImage      String?
  desktopBanner  String?
  mobileBanner   String?
  type           CollectionType      @default(MANUAL)
  ruleConfig     Json?
  isActive       Boolean             @default(true)
  isFeatured     Boolean             @default(false)
  sortOrder      Int                 @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  products       CollectionProduct[]

  @@index([isActive])
  @@index([type])
  @@index([isFeatured])
  @@index([sortOrder])
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model ProductBookDetails {
  id              String  @id @default(uuid())
  productId       String  @unique
  author          String?
  isbn            String?
  publisher       String?
  language        String?
  pageCount       Int?
  edition         String?
  publicationYear Int?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model BookFormatOption {
  id                String     @id @default(cuid())
  productId         String
  format            BookFormat
  price             Decimal    @db.Decimal(10, 2)
  salePrice         Decimal?   @db.Decimal(10, 2)
  mrp               Decimal?   @db.Decimal(10, 2)
  sku               String?
  isActive          Boolean    @default(true)
  stockQuantity     Int?
  trackInventory    Boolean?
  lowStockThreshold Int?
  weightGrams       Int?
  pdfFileKey        String?
  pdfOriginalName   String?
  maxDownloads      Int?
  expiryDays        Int?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  product           Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, format])
  @@index([productId])
}

model DigitalDownload {
  id               String    @id @default(cuid())
  orderItemId      String    @unique
  customerId       String?
  tokenHash        String    @unique
  downloadCount    Int       @default(0)
  maxDownloads     Int?
  expiresAt        DateTime?
  lastDownloadedAt DateTime?
  createdAt        DateTime  @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tokenHash])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id                     String        @id @default(uuid())
  orderSeq               Int           @default(autoincrement())
  orderNumber            String        @unique
  customerName           String
  customerEmail          String
  customerPhone          String
  customerAlternatePhone String?
  customerId             String?
  status                 OrderStatus   @default(PENDING)
  paymentStatus          PaymentStatus @default(PENDING)
  subtotal               Decimal       @db.Decimal(10, 2)
  shippingAmount         Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount         Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount              Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount            Decimal       @db.Decimal(10, 2)
  currency               String        @default("INR")
  couponCode             String?
  couponId               String?
  notes                  String?
  accessTokenHash        String
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  utmContent             String?
  utmTerm                String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  paidAt                 DateTime?
  cancelledAt            DateTime?

  paymentMethod         String    @default("cashfree")
  codFeeAmount          Decimal   @default(0) @db.Decimal(10, 2)
  shippingZoneId        String?
  billingSameAsShipping Boolean   @default(true)
  stockDecrementedAt    DateTime?
  stockRestoredAt       DateTime?

  items            OrderItem[]
  address          OrderAddress?
  billingAddress   OrderBillingAddress?
  payments         Payment[]
  customer         Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  couponRedemption CouponRedemption?
  shippingZone     ShippingZone?         @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  statusHistory    OrderStatusHistory[]
  shipment         Shipment?
  shipmentPackage  OrderShipmentPackage?
  invoice          Invoice?
  returnRequests   ReturnRequest[]

  @@index([orderNumber])
  @@index([customerEmail])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([couponCode])
  @@index([shippingZoneId])
}

model OrderBillingAddress {
  id             String  @id @default(uuid())
  orderId        String  @unique
  fullName       String
  phone          String
  alternatePhone String?
  email          String?
  landmark       String?
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  country        String  @default("India")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedAt       DateTime     @default(now())
  note            String?
  // Who/what caused the change: ADMIN | SHIPROCKET | PAYMENT | SYSTEM (internal; never shown to customers).
  source          String       @default("SYSTEM")
  adminId         String?
  shipmentId      String?
  providerEventId String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([changedAt])
}

model Shipment {
  id                 String    @id @default(uuid())
  orderId            String    @unique
  carrier            String?
  trackingNumber     String?
  trackingUrl        String?
  shippedDate        DateTime?
  estimatedDelivery  DateTime?
  deliveredDate      DateTime?
  provider           String    @default("MANUAL")
  providerOrderId    String?
  providerShipmentId String?
  awb                String?
  labelStorageKey    String?
  status             String    @default("PENDING")
  rawProviderStatus  String?
  lastError          String?
  pickupStatus      String?
  lastSyncedAt      DateTime?
  cancelledAt       DateTime?
  events            ShipmentEvent[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// A complete fiscal/legal snapshot. Nothing on an Invoice is derived from a
// live product or settings row after it has been created.
model Invoice {
  id              String     @id @default(uuid())
  orderId         String     @unique
  invoiceNumber   String?    @unique
  invoiceDate     DateTime   @default(now())
  customerName    String
  customerEmail   String
  customerPhone   String?
  billingAddress  Json
  shippingAddress Json?
  subtotal        Decimal    @db.Decimal(10, 2)
  discountAmount  Decimal    @default(0) @db.Decimal(10, 2)
  shippingAmount  Decimal    @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal    @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal    @db.Decimal(10, 2)
  currency        String     @default("INR")
  companySnapshot Json
  taxSnapshot     Json?
  itemsSnapshot   Json
  pdfStorageKey   String?
  emailedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  order           Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  emailLogs       EmailLog[]

  // --- Manual/offline invoice support (Phase 2) ---
  // source/status distinguish admin-created offline invoices from the
  // existing auto-generated flow. Every pre-existing row (and every row
  // created by ensureInvoiceForOrder) defaults to ONLINE/ISSUED so nothing
  // about the automatic flow changes behavior.
  source           String  @default("ONLINE") // "ONLINE" | "MANUAL"
  status           String  @default("ISSUED") // "DRAFT" | "ISSUED"
  createdByAdminId String?
  notes            String?
  paymentMethod    String?
  paymentReference String?

  // --- Optional externally-prepared PDF attachment ---
  // Deliberately separate from pdfStorageKey (the canonical generated PDF)
  // unless an admin explicitly designates it as canonical.
  externalPdfStorageKey  String?
  externalInvoiceNumber  String?
  externalInvoiceDate    DateTime?
  externalPdfUploadedAt  DateTime?
  externalPdfIsCanonical Boolean   @default(false)

  createdByAdmin AdminUser? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([customerEmail])
  @@index([createdAt])
  @@index([source])
  @@index([status])
}

model InvoiceSequence {
  id         String   @id @default("default")
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model IntegrationCredential {
  id            String    @id @default(uuid())
  provider      String
  environment   String
  encryptedData String
  isActive      Boolean   @default(true)
  lastTestedAt  DateTime?
  testStatus    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([provider, environment])
}

model EmailLog {
  id                String    @id @default(uuid())
  type              String
  recipient         String
  orderId           String?
  invoiceId         String?
  status            String
  providerMessageId String?
  sentAt            DateTime?
  failureMessage    String?
  createdAt         DateTime  @default(now())
  // Transactional notification metadata (never the body or any code/secret).
  event             String?
  subject           String?
  source            String?
  notificationId    String?
  audience          String    @default("CUSTOMER") // CUSTOMER | ADMIN
  invoice           Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([invoiceId])
  @@index([audience])
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  provider  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

model ShippingZone {
  id           String         @id @default(cuid())
  name         String
  states       String[]
  postalCodes  String[]       @default([])
  codSupported Boolean        @default(true)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  rates        ShippingRate[]
  orders       Order[]

  @@index([active])
}

model ShippingRate {
  id               String       @id @default(cuid())
  zoneId           String
  rate             Decimal      @db.Decimal(10, 2)
  freeAbove        Decimal?     @db.Decimal(10, 2)
  deliveryEstimate String?
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  zone             ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@index([active])
}

model OrderItem {
  id                        String      @id @default(uuid())
  orderId                   String
  productId                 String?
  variantId                 String?
  productNameSnapshot       String
  productSlugSnapshot       String
  skuSnapshot               String?
  unitPrice                 Decimal     @db.Decimal(10, 2)
  quantity                  Int
  lineTotal                 Decimal     @db.Decimal(10, 2)
  productTypeSnapshot       ProductType
  imageSnapshot             String?
  variantNameSnapshot       String?
  variantSkuSnapshot        String?
  variantAttributesSnapshot Json?
  variantPriceSnapshot      Decimal?    @db.Decimal(10, 2)
  bookFormatSnapshot        BookFormat?
  bookFormatSkuSnapshot     String?
  bookFormatPriceSnapshot   Decimal?    @db.Decimal(10, 2)
  bookFormatPdfNameSnapshot String?
  // GST snapshot fields captured at invoice-creation time (Phase 1 foundation).
  // Nullable: historical OrderItems predate this feature and never get one
  // backfilled.
  hsnCodeSnapshot           String?
  gstRateSnapshot           Decimal?    @db.Decimal(4, 2)
  unitSnapshot              String?
  cgstAmount                Decimal?    @db.Decimal(10, 2)
  sgstAmount                Decimal?    @db.Decimal(10, 2)
  igstAmount                Decimal?    @db.Decimal(10, 2)
  taxableValueSnapshot      Decimal?    @db.Decimal(10, 2)

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant         ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  digitalDownload DigitalDownload?
  returnItems     ReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderAddress {
  id             String  @id @default(uuid())
  orderId        String  @unique
  fullName       String
  phone          String
  alternatePhone String?
  email          String?
  landmark       String?
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  country        String  @default("India")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  provider          String        @default("cashfree")
  providerOrderId   String?
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  method            String?
  rawReference      String?
  refundedAmount    Decimal       @default(0) @db.Decimal(10, 2)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([providerOrderId])
  @@index([providerPaymentId])
}

// --- Returns / Refunds / RTO ---------------------------------------------

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  IN_TRANSIT
  RECEIVED
  REFUND_PENDING
  REFUNDED
  CLOSED
}

enum ReturnResolution {
  REFUND
  REPLACEMENT
  STORE_CREDIT
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum InventoryMovementType {
  SALE
  RETURN
  ADJUSTMENT
  RESTOCK
}

model ReturnRequest {
  id               String            @id @default(cuid())
  orderId          String
  customerId       String?
  status           ReturnStatus      @default(REQUESTED)
  reason           String
  details          String?
  resolution       ReturnResolution?
  refundAmount     Decimal?          @db.Decimal(10, 2)
  refundStatus     RefundStatus?
  providerRefundId String?
  restockedAt      DateTime?
  requestedAt      DateTime          @default(now())
  approvedAt       DateTime?
  rejectedAt       DateTime?
  receivedAt       DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  order    Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    ReturnItem[]
  refunds  Refund[]

  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

model ReturnItem {
  id              String   @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  createdAt       DateTime @default(now())

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
  @@index([orderItemId])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  productId       String?
  variantId       String?
  type            InventoryMovementType
  quantity        Int
  orderId         String?
  returnRequestId String?
  note            String?
  createdAt       DateTime              @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([returnRequestId])
  @@index([orderId])
}

model Refund {
  id                 String       @id @default(cuid())
  returnRequestId    String?
  paymentId          String
  orderId            String
  amount             Decimal      @db.Decimal(10, 2)
  method             String
  status             RefundStatus @default(PENDING)
  providerRefundId   String?
  reference          String?
  note               String?
  processedByAdminId String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([orderId])
  @@index([returnRequestId])
}

model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  eventId     String
  eventType   String
  processedAt DateTime @default(now())
  metadata    Json?

  @@unique([provider, eventId])
}

// One row per inbound webhook delivery (including rejected ones) so Admin can
// see integration health. Never stores payload bodies, signatures or secrets.
model WebhookDeliveryLog {
  id              String   @id @default(uuid())
  provider        String
  eventType       String?
  eventId         String?
  signatureResult String
  result          String
  reference       String?
  errorSummary    String?
  createdAt       DateTime @default(now())

  @@index([provider, createdAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id          String   @id @default(uuid())
  email       String   @unique
  consentedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

enum PageType {
  HOME
  STANDARD
  LANDING
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum BannerPlacement {
  HOME_HERO
  HOME_PROMO
  SHOP_TOP
  CATEGORY_TOP
  GLOBAL_PROMO
}

model Page {
  id             String     @id @default(uuid())
  name           String
  slug           String     @unique
  pageType       PageType   @default(STANDARD)
  status         PageStatus @default(DRAFT)
  content        String?    @db.Text
  featuredImage  String?
  excerpt        String?    @db.Text
  seoTitle       String?
  seoDescription String?    @db.Text
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sections PageSection[]

  @@index([slug])
  @@index([status])
  @@index([pageType])
}

model PageSection {
  id        String   @id @default(uuid())
  pageId    String
  type      String
  name      String?
  settings  Json?
  content   Json?
  isEnabled Boolean  @default(true)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([sortOrder])
}

model Banner {
  id                String          @id @default(uuid())
  name              String
  placement         BannerPlacement @default(HOME_HERO)
  desktopImage      String
  mobileImage       String?
  eyebrow           String?
  title             String
  highlightText     String?
  subtitle          String?
  primaryCtaLabel   String?
  primaryCtaUrl     String?
  secondaryCtaLabel String?
  secondaryCtaUrl   String?
  textPosition      String          @default("LEFT")
  textTheme         String          @default("DARK")
  startDate         DateTime?
  endDate           DateTime?
  isActive          Boolean         @default(true)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([placement])
  @@index([isActive])
  @@index([sortOrder])
}

model PromoMessage {
  id         String    @id @default(uuid())
  title      String
  message    String
  couponCode String?
  couponId   String?
  ctaLabel   String?
  ctaUrl     String?
  icon       String?
  startDate  DateTime?
  endDate    DateTime?
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([sortOrder])
  @@index([couponId])
}

model Coupon {
  id                    String             @id @default(uuid())
  code                  String             @unique
  name                  String?
  description           String?
  discountType          CouponDiscountType @default(PERCENTAGE)
  value                 Decimal            @db.Decimal(10, 2)
  minimumOrderAmount    Decimal?           @db.Decimal(10, 2)
  maximumDiscountAmount Decimal?           @db.Decimal(10, 2)
  validFrom             DateTime?
  validUntil            DateTime?
  usageLimit            Int?
  usageCount            Int                @default(0)
  perCustomerLimit      Int?
  isActive              Boolean            @default(true)
  targetType            CouponTargetType   @default(ALL)
  isPublic              Boolean            @default(false)
  displayTitle          String?
  terms                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  targets       CouponTarget[]
  redemptions   CouponRedemption[]
  promoMessages PromoMessage[]

  @@index([code])
  @@index([isActive])
  @@index([isPublic, isActive])
  @@index([validFrom, validUntil])
}

model WhatsNewItem {
  id        String    @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String?
  badge     String?
  ctaLabel  String?
  ctaUrl    String?
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, sortOrder])
  @@index([startDate, endDate])
}

model CouponTarget {
  id        String   @id @default(uuid())
  couponId  String
  targetId  String
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, targetId])
  @@index([couponId])
  @@index([targetId])
}

model CouponRedemption {
  id             String   @id @default(uuid())
  couponId       String
  customerId     String?
  customerEmail  String
  orderId        String   @unique
  discountAmount Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  coupon   Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([customerId])
  @@index([customerEmail])
}

model BlogPost {
  id             String     @id @default(uuid())
  title          String
  slug           String     @unique
  excerpt        String?    @db.Text
  featuredImage  String?
  content        String     @db.Text
  author         String?    @default("Aadya Editorial")
  category       String?
  tags           Json?
  isFeatured     Boolean    @default(false)
  status         PageStatus @default(DRAFT)
  publishDate    DateTime   @default(now())
  seoTitle       String?
  seoDescription String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([slug])
  @@index([status])
  @@index([publishDate])
  @@index([category])
  @@index([isFeatured])
}

model FAQCategory {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items FAQItem[]

  @@index([isActive])
  @@index([sortOrder])
}

model FAQItem {
  id         String   @id @default(uuid())
  categoryId String
  question   String
  answer     String   @db.Text
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category FAQCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([isActive])
  @@index([sortOrder])
}

model MediaAsset {
  id               String   @id @default(uuid())
  fileName         String
  originalName     String
  url              String
  storageKey       String
  storageDriver    String   @default("local")
  mimeType         String
  size             Int
  width            Int?
  height           Int?
  altText          String?
  title            String?
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([createdAt])
  @@index([storageKey])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProductReview {
  id                 String       @id @default(uuid())
  productId          String
  customerId         String
  rating             Int
  title              String?
  comment            String       @db.Text
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  moderatedAt        DateTime?
  moderatedByAdminId String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([productId])
  @@index([customerId])
  @@index([status])
  @@index([rating])
  @@index([createdAt])
}

model WishlistItem {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  variantId  String?
  createdAt  DateTime @default(now())

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId, variantId])
  @@index([customerId])
  @@index([productId])
}

model CustomerNotification {
  id         String   @id @default(uuid())
  customerId String
  type       String
  title      String
  message    String
  link       String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, isRead])
  @@index([createdAt])
}

// First-party analytics events. Everything except `purchase` may be written
// by the public POST /api/analytics/events endpoint (allowlisted `type`,
// no arbitrary write access). `purchase` is server-authoritative only —
// it is recorded from the payment-confirmation flow (finalizePaidPayment)
// and is never accepted from a client-submitted event.
model AnalyticsEvent {
  id           String   @id @default(cuid())
  type         String
  customerId   String?
  sessionId    String?
  productId    String?
  categoryId   String?
  collectionId String?
  orderId      String?
  metadata     Json?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  createdAt    DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([customerId])
  @@index([sessionId])
  @@index([productId])
  @@index([orderId])
  @@index([type, createdAt])
}

// --- Admin Notifications (low stock, order/payment/shipment/return/email/
// webhook/backup failures, system warnings). Admin-facing only — distinct
// from CustomerNotification. Other in-flight modules (email ops, returns,
// backup/monitoring) should call createAdminNotification() from
// server/src/modules/admin-notifications/admin-notification.service.js
// rather than writing to this table directly.
enum AdminNotificationType {
  NEW_ORDER
  PAYMENT_FAILED
  LOW_STOCK
  OUT_OF_STOCK
  SHIPMENT_FAILED
  RETURN_REQUESTED
  REFUND_FAILED
  EMAIL_FAILED
  WEBHOOK_FAILED
  BACKUP_FAILED
  SYSTEM_WARNING
}

enum AdminNotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model AdminNotification {
  id         String                    @id @default(uuid())
  type       AdminNotificationType
  title      String
  message    String
  severity   AdminNotificationSeverity @default(INFO)
  entityType String?
  entityId   String?
  isRead     Boolean                   @default(false)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@index([entityType, entityId])
}

// One-time email login codes. Only an HMAC of the 6-digit code is stored; codes expire after 10 minutes,
// are single-use and are invalidated after 5 wrong attempts.
model CustomerLoginOtp {
  id         String    @id @default(uuid())
  customerId String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

// One row per customer-facing notification that must be sent at most once (for example "your order
// shipped"). The unique dedupeKey is the idempotency guard: the same event reaching us from an Admin
// click, a Shiprocket webhook and a retry still produces one email.
model NotificationEvent {
  id              String    @id @default(uuid())
  dedupeKey       String    @unique
  event           String
  orderId         String?
  customerId      String?
  recipient       String
  source          String
  providerEventId String?
  audience        String    @default("CUSTOMER") // CUSTOMER | ADMIN (internal notification)
  status          String    @default("PENDING") // PENDING | SENT | FAILED
  attempts        Int       @default(0)
  lastError       String?
  nextRetryAt     DateTime?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderId])
  @@index([status, nextRetryAt])
}

// Admin-editable wording for a transactional email. Layout, order summary and safety rules stay in
// code; only subject, heading and message text (with whitelisted {{placeholders}}) are editable.
model EmailTemplate {
  id          String   @id @default(uuid())
  key         String   @unique
  subject     String
  heading     String
  body        String
  enabled     Boolean  @default(true)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Internal recipients of Admin notification emails (new order, payment, shipment events). Which events
// are emailed is stored in the private `adminNotifications` site setting; sending reuses the SMTP integration.
model AdminNotificationRecipient {
  id        String   @id @default(uuid())
  email     String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The package an Admin confirmed for an order. A snapshot: later product edits never change it.
model OrderShipmentPackage {
  id            String    @id @default(uuid())
  orderId       String    @unique
  weightGrams   Int
  lengthMm      Int
  widthMm       Int
  heightMm      Int
  // AUTO_SINGLE | AUTO_ESTIMATE | MANUAL_OVERRIDE
  source        String
  presetName    String?
  itemsSnapshot Json?
  confirmedAt   DateTime  @default(now())
  confirmedBy   String?
  // Set once a provider shipment has been created from this package; the snapshot is then frozen.
  lockedAt      DateTime?
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// Optional reusable box sizes for multi-product orders.
model PackagePreset {
  id        String   @id @default(uuid())
  name      String   @unique
  lengthMm  Int
  widthMm   Int
  heightMm  Int
  tareGrams Int      @default(0)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Customer-facing shipment milestones. One row per distinct status the shipment reached; never holds provider
// payloads, actors or webhook ids (those stay in WebhookEvent / OrderStatusHistory).
model ShipmentEvent {
  id         String   @id @default(uuid())
  shipmentId String
  orderId    String
  status     String
  label      String
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, status])
  @@index([orderId])
}
