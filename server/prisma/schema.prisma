generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum ProductType {
  BOOK
  PHYSICAL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model AdminUser {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

model Customer {
  id                String                 @id @default(uuid())
  name              String
  email             String                 @unique
  phone             String?
  passwordHash      String
  isActive          Boolean                @default(true)
  emailVerifiedAt   DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  addresses         Address[]
  orders            Order[]
  refreshSessions   CustomerRefreshSession[]
  passwordResets    PasswordResetToken[]
  cart              Cart?
  couponRedemptions CouponRedemption[]

  @@index([email])
}

model Address {
  id           String   @id @default(uuid())
  customerId   String
  label        String
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String   @default("India")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerRefreshSession {
  id         String   @id @default(uuid())
  customerId String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  userAgent  String?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  customerId String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model Cart {
  id         String     @id @default(uuid())
  customerId String     @unique
  updatedAt  DateTime   @updatedAt
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@index([productId])
}

model Category {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  description    String?
  parentId       String?
  image          String?
  icon           String?
  logo           String?
  desktopBanner  String?
  mobileBanner   String?
  isFeatured     Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToSubcategory")
  products Product[]

  @@index([parentId])
  @@index([isActive])
  @@index([isFeatured])
}

model NavigationMenu {
  id        String           @id @default(uuid())
  code      String           @unique
  title     String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  items     NavigationItem[]

  @@index([code])
}

enum NavigationItemType {
  CATEGORY
  COLLECTION
  PAGE
  CUSTOM
}

model NavigationItem {
  id        String             @id @default(uuid())
  menuId    String
  parentId  String?
  title     String
  url       String?
  type      NavigationItemType @default(CUSTOM)
  targetId  String?
  sortOrder Int                @default(0)
  isActive  Boolean            @default(true)
  icon      String?
  badgeText String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  menu     NavigationMenu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   NavigationItem?  @relation("NavItemToSubItem", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavItemToSubItem")

  @@index([menuId])
  @@index([parentId])
  @@index([sortOrder])
}

enum CollectionType {
  MANUAL
  CATEGORY
  TAG
  FEATURED
  BEST_SELLER
  NEW_ARRIVAL
  TRENDING
  PRICE_RANGE
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponTargetType {
  ALL
  PRODUCT
  CATEGORY
  COLLECTION
}

model Product {
  id                  String              @id @default(uuid())
  name                String
  slug                String              @unique
  brand               String?
  shortDescription    String?
  description         String?
  productType         ProductType
  categoryId          String
  sku                 String?             @unique
  price               Decimal             @db.Decimal(10, 2)
  salePrice           Decimal?            @db.Decimal(10, 2)
  mrp                 Decimal?            @db.Decimal(10, 2)
  costPrice           Decimal?            @db.Decimal(10, 2)
  stockQuantity       Int                 @default(0)
  lowStockThreshold   Int                 @default(5)
  trackInventory      Boolean             @default(true)
  isFeatured          Boolean             @default(false)
  isBestSeller        Boolean             @default(false)
  isNewArrival        Boolean             @default(false)
  isTrending          Boolean             @default(false)
  isActive            Boolean             @default(true)
  sortOrder           Int                 @default(0)
  tags                String[]            @default([])
  materials           String?
  dimensions          String?
  careInstructions    String?
  whatsIncluded       String?
  shippingInformation String?
  specifications      Json?
  seoTitle            String?
  seoDescription      String?
  ogImage             String?
  attributes          Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  category   Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  bookDetail ProductBookDetails?
  orderItems OrderItem[]
  cartItems  CartItem[]
  collections CollectionProduct[]
  variants   ProductVariant[]

  @@index([categoryId])
  @@index([productType])
  @@index([isActive])
  @@index([isFeatured])
  @@index([isBestSeller])
  @@index([isNewArrival])
  @@index([isTrending])
  @@index([sortOrder])
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  name          String
  sku           String   @unique
  priceOverride Decimal? @db.Decimal(10, 2)
  stockQuantity Int      @default(0)
  isActive      Boolean  @default(true)
  attributes    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([productId, isActive])
}

model Collection {
  id             String              @id @default(uuid())
  title          String
  slug           String              @unique
  description    String?
  heroImage      String?
  desktopBanner  String?
  mobileBanner   String?
  type           CollectionType      @default(MANUAL)
  ruleConfig     Json?
  isActive       Boolean             @default(true)
  isFeatured     Boolean             @default(false)
  sortOrder      Int                 @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  products       CollectionProduct[]

  @@index([isActive])
  @@index([type])
  @@index([isFeatured])
  @@index([sortOrder])
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model ProductBookDetails {
  id              String  @id @default(uuid())
  productId       String  @unique
  author          String?
  isbn            String?
  publisher       String?
  language        String?
  pageCount       Int?
  edition         String?
  publicationYear Int?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id              String        @id @default(uuid())
  orderSeq        Int           @default(autoincrement())
  orderNumber     String        @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  customerId      String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  subtotal        Decimal       @db.Decimal(10, 2)
  shippingAmount  Decimal       @db.Decimal(10, 2) @default(0)
  discountAmount  Decimal       @db.Decimal(10, 2) @default(0)
  taxAmount       Decimal       @db.Decimal(10, 2) @default(0)
  totalAmount     Decimal       @db.Decimal(10, 2)
  currency        String        @default("INR")
  couponCode      String?
  couponId        String?
  notes           String?
  accessTokenHash String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paidAt          DateTime?
  cancelledAt     DateTime?

  items            OrderItem[]
  address          OrderAddress?
  payments         Payment[]
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  couponRedemption CouponRedemption?

  @@index([orderNumber])
  @@index([customerEmail])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([couponCode])
}

model OrderItem {
  id                         String          @id @default(uuid())
  orderId                    String
  productId                  String?
  variantId                  String?
  productNameSnapshot        String
  productSlugSnapshot        String
  skuSnapshot                String?
  unitPrice                  Decimal         @db.Decimal(10, 2)
  quantity                   Int
  lineTotal                  Decimal         @db.Decimal(10, 2)
  productTypeSnapshot        ProductType
  imageSnapshot              String?
  variantNameSnapshot        String?
  variantSkuSnapshot         String?
  variantAttributesSnapshot Json?
  variantPriceSnapshot       Decimal?        @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderAddress {
  id           String  @id @default(uuid())
  orderId      String  @unique
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String  @default("India")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  provider          String        @default("razorpay")
  providerOrderId   String?
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  method            String?
  rawReference      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerOrderId])
  @@index([providerPaymentId])
}

model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  eventId     String
  eventType   String
  processedAt DateTime @default(now())
  metadata    Json?

  @@unique([provider, eventId])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id          String   @id @default(uuid())
  email       String   @unique
  consentedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

enum PageType {
  HOME
  STANDARD
  LANDING
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum BannerPlacement {
  HOME_HERO
  HOME_PROMO
  SHOP_TOP
  CATEGORY_TOP
  GLOBAL_PROMO
}

model Page {
  id             String        @id @default(uuid())
  name           String
  slug           String        @unique
  pageType       PageType      @default(STANDARD)
  status         PageStatus    @default(DRAFT)
  content        String?       @db.Text
  featuredImage  String?
  excerpt        String?       @db.Text
  seoTitle       String?
  seoDescription String?       @db.Text
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sections PageSection[]

  @@index([slug])
  @@index([status])
  @@index([pageType])
}

model PageSection {
  id        String   @id @default(uuid())
  pageId    String
  type      String
  name      String?
  settings  Json?
  content   Json?
  isEnabled Boolean  @default(true)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([sortOrder])
}

model Banner {
  id                String          @id @default(uuid())
  name              String
  placement         BannerPlacement @default(HOME_HERO)
  desktopImage      String
  mobileImage       String?
  eyebrow           String?
  title             String
  highlightText     String?
  subtitle          String?
  primaryCtaLabel   String?
  primaryCtaUrl     String?
  secondaryCtaLabel String?
  secondaryCtaUrl   String?
  textPosition      String          @default("LEFT")
  textTheme         String          @default("DARK")
  startDate         DateTime?
  endDate           DateTime?
  isActive          Boolean         @default(true)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([placement])
  @@index([isActive])
  @@index([sortOrder])
}

model PromoMessage {
  id              String    @id @default(uuid())
  title           String
  message         String
  couponCode      String?
  couponId        String?
  ctaLabel        String?
  ctaUrl          String?
  icon            String?
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([sortOrder])
  @@index([couponId])
}

model Coupon {
  id                    String             @id @default(uuid())
  code                  String             @unique
  name                  String?
  description           String?
  discountType          CouponDiscountType @default(PERCENTAGE)
  value                 Decimal            @db.Decimal(10, 2)
  minimumOrderAmount    Decimal?           @db.Decimal(10, 2)
  maximumDiscountAmount Decimal?           @db.Decimal(10, 2)
  validFrom             DateTime?
  validUntil            DateTime?
  usageLimit            Int?
  usageCount            Int                @default(0)
  perCustomerLimit      Int?
  isActive              Boolean            @default(true)
  targetType            CouponTargetType   @default(ALL)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  targets       CouponTarget[]
  redemptions   CouponRedemption[]
  promoMessages PromoMessage[]

  @@index([code])
  @@index([isActive])
  @@index([validFrom, validUntil])
}

model CouponTarget {
  id        String   @id @default(uuid())
  couponId  String
  targetId  String
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, targetId])
  @@index([couponId])
  @@index([targetId])
}

model CouponRedemption {
  id             String   @id @default(uuid())
  couponId       String
  customerId     String?
  customerEmail  String
  orderId        String   @unique
  discountAmount Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  coupon   Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([customerId])
  @@index([customerEmail])
}

model BlogPost {
  id             String     @id @default(uuid())
  title          String
  slug           String     @unique
  excerpt        String?    @db.Text
  featuredImage  String?
  content        String     @db.Text
  author         String?    @default("Aadya Editorial")
  category       String?
  tags           Json?
  isFeatured     Boolean    @default(false)
  status         PageStatus @default(DRAFT)
  publishDate    DateTime   @default(now())
  seoTitle       String?
  seoDescription String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([slug])
  @@index([status])
  @@index([publishDate])
  @@index([category])
  @@index([isFeatured])
}

model FAQCategory {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items FAQItem[]

  @@index([isActive])
  @@index([sortOrder])
}

model FAQItem {
  id         String      @id @default(uuid())
  categoryId String
  question   String
  answer     String      @db.Text
  sortOrder  Int         @default(0)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  category FAQCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([isActive])
  @@index([sortOrder])
}

model MediaAsset {
  id               String   @id @default(uuid())
  fileName         String
  originalName     String
  url              String
  storageKey       String
  storageDriver    String   @default("local")
  mimeType         String
  size             Int
  width            Int?
  height           Int?
  altText          String?
  title            String?
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([createdAt])
  @@index([storageKey])
}
