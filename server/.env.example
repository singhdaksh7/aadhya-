# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4100

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/aadya?schema=public"

# CORS: the storefront/admin origin allowed to call this API with credentials
FRONTEND_URL="http://localhost:5173"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# First admin seed (used only by `npm run seed`, never hardcoded in code)
ADMIN_NAME="Aadya Admin"
ADMIN_EMAIL="admin@aadyasociety.example"
ADMIN_PASSWORD="ChangeThisPassword123!"

# Uploads
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_DIR="uploads/products"

# Shipping (rupees) — flat rule: free above the threshold, flat fee below it
FREE_SHIPPING_THRESHOLD=2000
STANDARD_SHIPPING_AMOUNT=99

# Razorpay (TEST mode keys for development — never commit real values)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP (order confirmation email). Leave blank to disable email sending —
# it fails gracefully and logs instead of blocking checkout/webhooks.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Aadya Society <no-reply@aadyasociety.example>"
