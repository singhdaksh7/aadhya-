# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4100

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/aadya?schema=public"

# CORS: the storefront/admin origin allowed to call this API with credentials
FRONTEND_URL="http://localhost:5173"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# First admin seed (used only by `npm run seed`, never hardcoded in code)
ADMIN_NAME="Aadya Admin"
ADMIN_EMAIL="admin@aadyasociety.example"
ADMIN_PASSWORD="ChangeThisPassword123!"

# `npm run seed` always creates the admin user above. It only seeds the
# demo/placeholder catalog (books, products, collections) when this is
# "true" (or via `npm run seed:demo`). Leave unset/false in production so a
# fresh deploy doesn't get populated with demo merchandising automatically.
SEED_DEMO_CATALOG=false

# Uploads
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_DIR="uploads/products"

# Storage driver: "local" (default, disk under UPLOAD_DIR) or "s3".
# Note: invoice logo/signature image embedding currently only resolves
# local-disk uploads; on "s3" those fall back to text (safe, not broken).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Shipping (rupees) — flat rule: free above the threshold, flat fee below it
FREE_SHIPPING_THRESHOLD=2000
STANDARD_SHIPPING_AMOUNT=99

# Razorpay (TEST mode keys for development — never commit real values)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Exactly 32 bytes, base64-encoded (or 64 hex characters). Server-only.
INTEGRATION_ENCRYPTION_KEY=
PRIVATE_INVOICE_DIR="private/invoices"

# SMTP (order confirmation email). Leave blank to disable email sending —
# it fails gracefully and logs instead of blocking checkout/webhooks.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Aadya Society <no-reply@aadyasociety.example>"
