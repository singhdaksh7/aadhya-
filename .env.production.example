# Copy to .env.production on the VPS and fill in real values.
# NEVER commit .env.production — it is gitignored.
#
# This file is consumed by docker-compose.prod.yml (via `env_file`) for the
# backend container, and via --build-arg for the frontend's VITE_API_URL.

# --- Postgres (aadya-db) ---
POSTGRES_USER=aadya
POSTGRES_PASSWORD=
POSTGRES_DB=aadya

# --- Backend (aadya-api) ---
NODE_ENV=production
PORT=4100

# DATABASE_URL is NOT set here — docker-compose.prod.yml builds it
# automatically from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above, so
# the two can never drift apart. Only set DATABASE_URL yourself if you are
# running the backend outside this compose file (e.g. a managed Postgres).

# The exact storefront origin — required for CORS + secure cookies.
FRONTEND_URL=https://store.example.com

# Long, random secrets — e.g. `openssl rand -base64 48`. Never reuse dev/test values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# First admin account — created by `npx prisma db seed` / `npm run seed`
# (admin only; demo catalog is opt-in, see SEED_DEMO_CATALOG below).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Leave false/unset in production — do not populate the live store with
# placeholder demo products automatically.
SEED_DEMO_CATALOG=false

# Razorpay — leave blank to keep payments disabled honestly until real
# (or test) keys are available. Never fake a successful payment path.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP — leave blank to disable transactional email; checkout must still
# complete without it (see server/src/modules/email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Aadya Society <no-reply@example.com>"

FREE_SHIPPING_THRESHOLD=2000
STANDARD_SHIPPING_AMOUNT=99

# Uploads — local disk is used by default (persisted via the aadya_uploads
# Docker volume). Set STORAGE_DRIVER=s3 and fill the S3_* vars below only if
# you are moving product image storage off the container filesystem.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Frontend build-time (aadya-web) ---
# Baked into the static bundle at build time — rebuild the image to change it.
VITE_API_URL=https://api-store.example.com/api

# --- Reverse proxy / domains (used by docker-compose.prod.yml labels) ---
DOMAIN=example.com
TRAEFIK_NETWORK=traefik_public
TRAEFIK_CERT_RESOLVER=le
